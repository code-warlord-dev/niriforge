// Input devices.

input {
    keyboard {
        xkb {
            layout "us,ru"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    mouse {
        natural-scroll
        accel-speed 0.4
    }
}

cursor {
    xcursor-size 24
    hide-when-typing
}

environment {
    NIRIFORGE_PROFILE "cachyos"
    QT_QPA_PLATFORM "wayland"
}
