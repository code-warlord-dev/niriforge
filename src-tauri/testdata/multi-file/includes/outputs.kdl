// Outputs, split off into their own file.

output "eDP-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-2" {
    mode "2560x1440@144.000"
    scale 1
    position x=1920 y=0
}

// A laptop panel that is only used with the lid closed.
/-output "DP-3" {
    scale 1
}
